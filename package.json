        "@ckeditor/ckeditor5-code-block": "^47.5.0",
        "@ckeditor/ckeditor5-find-and-replace": "^47.5.0",
        "@ckeditor/ckeditor5-font": "^47.5.0",
        "@ckeditor/ckeditor5-horizontal-line": "^47.5.0",
        "@ckeditor/ckeditor5-react": "^11.0.1",
        "@ckeditor/ckeditor5-remove-format": "^47.5.0",
        "@ckeditor/ckeditor5-source-editing": "^47.5.0",
        "@ckeditor/ckeditor5-special-characters": "^47.5.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^3.10.0",
        "@prisma/client": "^6.19.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "clsx": "^2.1.1",
        "date-fns": "^2.30.0",
        "framer-motion": "^10.18.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.288.0",
        "mysql2": "^3.15.3",
        "next": "^14.2.33",
        "node-fetch": "^2.7.0",
        "nodemailer": "^9.0.1",
        "php-serialize": "^5.1.3",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-headless-pagination": "^1.1.6",
        "react-hook-form": "^7.66.0",
        "recharts": "^3.10.1",
        "resend": "^6.10.0",
        "sharp": "^0.34.5",
        "swc": "^1.0.11",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.0.0",
        "xlsx": "^0.18.5",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mdast": "^4.0.4",
        "@types/node": "^20.0.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "autoprefixer": "^10.4.22",
        "caniuse-lite": "^1.0.30001760",
        "eslint": "^8.0.0",
        "eslint-config-next": "14.0.0",
        "postcss": "^8.4.0",
        "prisma": "^6.19.3",
        "ts-node": "^10.9.2"
    },
    "optionalDependencies": {
        "@img/sharp-libvips-linux-x64": "1.2.4",
        "@next/swc-win32-x64-msvc": "^14.2.33"
    }
}
