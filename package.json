{
    "name": "workout-management-system",
    "version": "1.0.0",
    "prisma": {
        "seed": "ts-node -r tsconfig-paths/register --transpile-only -P prisma/tsconfig.seed.json prisma/seed.ts"
    },
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "prisma generate && next build",
        "build:clean": "rm -rf .next && npm run build",
        "start": "next start -p 3000",
        "lint": "next lint",
        "db:push": "prisma db push",
        "db:fix-food-legacy-ids": "npx tsx scripts/fix-food-database-legacy-ids.ts",
        "db:migrate": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "prisma db seed",
        "prisma:generate": "prisma generate",
        "postinstall": "prisma generate",
        "admin:reset": "node scripts/reset-super-admin.js",
        "admin:force-reset": "node scripts/force-reset-password.js",
        "admin:full-reset": "node scripts/force-reset-password.js --full-reset",
        "admin:update-password": "node scripts/update-admin-password.js",
        "admin:update-usertype": "node scripts/update-admin-usertype.js",
        "admin:test-password": "node scripts/test-admin-password.js",
        "import:legacy-users": "node scripts/import-legacy-users.js",
        "db:compare": "node scripts/compare-databases.js",
        "db:check-prod": "node scripts/check-production-db.js",
        "admin:check": "node scripts/check-admin.js",
        "db:migrate-text": "node scripts/migrate-text-fields.js",
        "db:add-moveframe-fields": "node scripts/add-moveframe-fields.js",
        "db:check-manual": "node scripts/check-manual-moveframes.js",
        "db:seed-outcome-settings": "node scripts/seed-outcome-settings-dev.js",
        "db:seed-procedures": "ts-node -r tsconfig-paths/register --transpile-only -P prisma/tsconfig.seed.json prisma/seed-procedure-types.ts",
        "db:seed-outcomes": "ts-node -r tsconfig-paths/register --transpile-only -P prisma/tsconfig.seed.json prisma/seed-outcomes.ts",
        "db:migrate-outcomes": "ts-node -r tsconfig-paths/register --transpile-only -P prisma/tsconfig.seed.json scripts/migrate-outcomes-from-legacy.ts",
        "db:ensure-promocode-meta": "npx tsx scripts/ensure-promocode-meta.ts",
        "db:backfill-versions": "npx tsx scripts/backfill-subscription-versions.ts"
    },
    "dependencies": {
        "@ckeditor/ckeditor5-alignment": "^47.5.0",
