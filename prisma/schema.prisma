generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(cuid())
  email                    String                @unique
  username                 String                @unique
  password                 String
  name                     String
  userType                 UserType
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  birthdate                DateTime?
  country                  String?
  firstName                String?
  gender                   String?
  surname                  String?
  securityQuestion         String?
  securityAnswer           String?
  clubMemberships          ClubMember[]
  clubMemberGroupItems     ClubMemberGroupMember[]
  clubMemberFavorites      ClubMemberFavorite[]
  ownedClubs               Club[]                @relation("ClubOwner")
  coaches                  CoachAthlete[]        @relation("AthleteCoaches")
  athletes                 CoachAthlete[]        @relation("CoachAthletes")
  coachingGroupMemberships CoachingGroupMember[]
  ownedCoachingGroups      CoachingGroup[]       @relation("CoachingGroupOwner")
  favoriteWorkouts         FavoriteWorkout[]
  favoriteWeeklyPlans      FavoriteWeeklyPlan[]
  favoriteSports           FavoriteSport[]
  freeMoveExercises        FreeMoveExercise[]
  groupMemberships         GroupMember[]
  ownedGroups              Group[]               @relation("GroupOwner")
  periods                  Period[]
  teamMemberships          TeamMember[]
  ownedTeams               Team[]                @relation("TeamOwner")
  mainSports               UserMainSport[]
  settings                 UserSettings?
  profileExtras            UserProfileExtras?
  workoutDays              WorkoutDay[]
  workoutPlans             WorkoutPlan[]
  sections                 WorkoutSection[]
  executionTechniques      ExecutionTechnique[]
  workoutTemplates         WorkoutTemplate[]
  telegramAccount          String?
  telegramChatId           String?   // Telegram chat id for sending/receiving via bot
  lastSeenAt               DateTime? // For chat online/offline status
  /// Profile/avatar: public path, remote URL, or data URL (operator-style upload stores data:image/...).
  image                    String?   @db.LongText
  /// Cover/banner: public path, remote URL, or data URL (banner-upload stores data:image/...).
  profileBanner            String?   @db.LongText
  profileBannerAlignment   String?   // "center" | "default" — object-position for cover (legacy)
  /// JSON string[] of banner paths / data URLs for rotating cover
  profileBannerSequence    String?   @db.LongText
  profileBannerVideo       String?   // Uploaded cover video path (public URL under /uploads/...)
  /// Personal YouTube URL (channel, @handle, or video) for "My channel on YouTube" on My Page.
  youtubeChannelUrl        String?   @db.Text
  superAdminId             String?   @unique // When set, this User mirrors a super_admin for news/OGP attribution
  conversationsStarted    ChatConversation[] @relation("ConversationStarter")
  conversationsReceived   ChatConversation[] @relation("ConversationReceiver")
  chatMessagesSent         ChatMessage[]     @relation("MessageSender")
  userMessageThreads      UserMessageThread[]
  userThreadMessagesSent  UserThreadMessage[] @relation("UserThreadMessageSender")
  userMessageThreadLikes  UserMessageThreadLike[]
  newsTopics               UserNewsTopic[]
  ogpArticles              OgpArticle[]
  ogpArticlesDeleted       OgpArticle[]       @relation("OgpDeletedBy")
  ogpArticleLikes          OgpArticleLike[]
  ogpNewsGroups            OgpNewsGroup[]
  ogpNewsGroupLikes        OgpNewsGroupLike[]
  newsTypedArticles       NewsTypedArticle[]
  musicTopics              UserMusicTopic[]
  musicOgpArticles         MusicOgpArticle[]
  musicOgpArticlesDeleted  MusicOgpArticle[]  @relation("MusicOgpDeletedBy")
  musicOgpArticleLikes     MusicOgpArticleLike[]
  musicOgpListenHistory    MusicOgpListenHistory[]
  musicOgpGroups           MusicOgpGroup[]
  musicOgpGroupLikes       MusicOgpGroupLike[]
  musicTypedArticles       MusicTypedArticle[]
  exerciseTopics              UserExerciseTopic[]
  exerciseOgpArticles         ExerciseOgpArticle[]
  exerciseOgpArticlesDeleted  ExerciseOgpArticle[]  @relation("ExerciseOgpDeletedBy")
  exerciseOgpArticleLikes     ExerciseOgpArticleLike[]
  exerciseOgpGroups           ExerciseOgpGroup[]
  exerciseOgpGroupLikes       ExerciseOgpGroupLike[]
  exerciseTypedArticles       ExerciseTypedArticle[]
  plannedActionTemplates  PlannedActionTemplate[]
  workoutDayPlannedActions WorkoutDayPlannedAction[]
  sportMachines           SportMachine[]
  loginLogs               UserLoginLog[]
  globalWorkoutArchiveShares GlobalWorkoutArchiveEntry[] @relation("GlobalArchiveSharedBy")
  nutritionDays           NutritionDay[]
  nutritionPlans          NutritionPlan[]
  nutritionSections       NutritionSection[]
  favoriteNutritionMeals  FavoriteNutritionMeal[]
  favoriteNutritionWeeklyPlans FavoriteNutritionWeeklyPlan[]
  nutritionTemplates           NutritionTemplate[]
  nutritionDayPlannedActions   NutritionDayPlannedAction[]
  procedureRecordsAsMember     ProcedureRecord[]  @relation("ProcedureMember")
  procedureRecordsAsOperator   ProcedureRecord[]  @relation("ProcedureOperator")
  procedurePaymentsAsOperator  ProcedurePayment[] @relation("ProcedurePaymentOperator")
  procedureReceiptsAsMember    ProcedureReceipt[] @relation("ProcedureReceiptMember")
  procedureReceiptsAsOperator  ProcedureReceipt[] @relation("ProcedureReceiptOperator")
  clubSharedOgpArticles        ClubSharedOgpArticle[] @relation("ClubSharedOgpBy")
  clubSharedOgpGroups          ClubSharedOgpGroup[]   @relation("ClubSharedOgpGroupBy")
  clubSharedNews               ClubSharedNews[]       @relation("ClubSharedNewsBy")
  clubStaffRoles               ClubStaff[]
  teamStaffRoles               TeamStaff[]
  notificationsSubmitted       Notification[]         @relation("NotificationSubmittedBy")
  notificationVisits           NotificationVisit[]

  @@map("users_new")
}

/// Login / logout audit rows for Movesbook users (admin "Logins about users").
model UserLoginLog {
  id        String    @id @default(cuid())
  userId    String
  loginAt   DateTime
  logoutAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([userId, logoutAt])
  @@map("user_login_logs")
}

model MyDeskItem {
  id          String      @id @default(cuid())
  userId      String
  parentId    String?
  title       String
  path        String?
  faIconClass String?
  bgColor     String?
  titleColor  String?
  displayMode String? // "new_label" | "central_page"
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   MyDeskItem? @relation("MyDeskParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children MyDeskItem[] @relation("MyDeskParentChild")

  @@index([userId, parentId, sortOrder])
  @@index([parentId])
  @@map("my_desk_items")
}

/** Club Desk tree — same shape as My Desk, scoped to a club (admin-managed). */
model ClubDeskItem {
  id          String    @id @default(cuid())
  clubId      String
  parentId    String?
  title       String
  path        String?
  faIconClass String?
  bgColor     String?
  titleColor  String?
  displayMode String? // "new_label" | "central_page"
  visible     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   ClubDeskItem?  @relation("ClubDeskParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children ClubDeskItem[] @relation("ClubDeskParentChild")

  @@index([clubId, parentId, sortOrder])
  @@index([parentId])
  @@map("club_desk_items")
}

model UserNewsTopic {
  id          String   @id @default(cuid())
  userId      String
  name        String
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_news_topics")
}

model OgpArticle {
  id                    String    @id @default(cuid())
  userId                String
  title                 String?   @db.Text
  image                 String?   @db.Text
  description           String?   @db.Text
  url                   String    @db.Text
  siteName              String?
  type                  String?
  customDescription     String?   @db.Text
  topic                 String    // Topic name (e.g. "News", "Sport")
  languageCode          String?   // Language of the article e.g. "en", "it" for search/filter
  savedAt               DateTime  @default(now())
  expiresAt             DateTime? // After this date hidden from normal users; admin/super_admin still see
  deletedAt             DateTime? // Set when deleted by creator (soft delete); admin/super_admin delete permanently
  deletedByUserId       String?   // Who performed soft delete (creator's user id); for display "deleted by"
  visibilityUserTypes   String?   @db.Text // JSON array of UserType e.g. ["ATHLETE","COACH"]
  visibilityCountries   String?   @db.Text // JSON array of country names
  visibilityLanguages   String?   @db.Text // JSON array of language codes e.g. ["en","de"]
  visibilitySports      String?   @db.Text // JSON array of SportType e.g. ["RUN","SWIM"]
  inGlobalNews          Boolean   @default(false) // Super admin: shown in Global News merged feed
  isFeatured            Boolean   @default(false) // Super admin: promoted to featured News Card (hero)
  displayInEvidence     Boolean   @default(true) // Super admin: show/hide in featured News Card when isFeatured
  /// Times this OGP News was opened. Used for News Headlines / Top Stories ranking.
  viewCount             Int       @default(0)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy             User?     @relation("OgpDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  likes                 OgpArticleLike[]
  groupItems            OgpNewsGroupItem[]
  clubShares            ClubSharedOgpArticle[]

  @@index([userId])
  @@index([userId, topic])
  @@index([deletedAt])
  @@index([viewCount])
  @@map("ogp_articles")
}

model OgpArticleLike {
  id            String      @id @default(cuid())
  ogpArticleId  String
  userId        String
  createdAt     DateTime    @default(now())
  ogpArticle    OgpArticle   @relation(fields: [ogpArticleId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ogpArticleId, userId])
  @@index([ogpArticleId])
  @@index([userId])
  @@map("ogp_article_likes")
}

/// Named collection of OGP News articles (OGP News group).
model OgpNewsGroup {
  id                    String    @id @default(cuid())
  userId                String
  name                  String
  topic                 String
  customDescription     String?   @db.Text
  /// Optional custom cover; when null, UI uses the 1st member OGP's image/video.
  coverImage            String?   @db.Text
  savedAt               DateTime  @default(now())
  expiresAt             DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?
  visibilityUserTypes   String?   @db.Text
  visibilityCountries   String?   @db.Text
  visibilityLanguages   String?   @db.Text
  visibilitySports      String?   @db.Text
  /// Club OGP News audience: only-me | me-and-club-members | me-club-members-and-filters
  audienceMode          String    @default("me-and-club-members")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OgpNewsGroupItem[]
  likes                 OgpNewsGroupLike[]
  clubShares            ClubSharedOgpGroup[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, topic])
  @@index([topic])
  @@index([deletedAt])
  @@map("ogp_news_groups")
}

model OgpNewsGroupItem {
  id           String      @id @default(cuid())
  groupId      String
  ogpArticleId String
  sortOrder    Int         @default(0)
  addedAt      DateTime    @default(now())
  group        OgpNewsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ogpArticle   OgpArticle  @relation(fields: [ogpArticleId], references: [id], onDelete: Cascade)

  @@unique([groupId, ogpArticleId])
  @@index([groupId])
  @@index([ogpArticleId])
  @@map("ogp_news_group_items")
}

model OgpNewsGroupLike {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime    @default(now())
  group     OgpNewsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("ogp_news_group_likes")
}

/// Singleton placement rules for OGP News sponsored cards (super admin).
model OgpNewsSponsorSettings {
  id           String           @id @default("default")
  /// A: first sponsor row (1–5). If that row does not exist on a page, use the last row available.
  startRow     Int              @default(2)
  /// B: repeat every N rows after the first sponsor (3–99), counting across pages.
  intervalRows Int              @default(12)
  /// Rotation delay in milliseconds when more than one sponsor is configured.
  delayMs      Int              @default(5000)
  /// When false, all sponsored cards are hidden from the news feed.
  enabled      Boolean          @default(true)
  updatedAt    DateTime         @updatedAt
  sponsors     OgpNewsSponsor[]

  @@map("ogp_news_sponsor_settings")
}

model OgpNewsSponsor {
  id          String                  @id @default(cuid())
  settingsId  String                  @default("default")
  image       String                  @db.Text
  /// "single" (1 grid cell) or "double" (2 grid cells).
  size        String                  @default("single")
  hoverTitle  String?                 @db.Text
  linkUrl     String                  @db.Text
  /// "tab" (new browser tab) or "window" (new browser window).
  linkTarget  String                  @default("tab")
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  settings    OgpNewsSponsorSettings  @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, sortOrder])
  @@map("ogp_news_sponsors")
}

model NewsTypedArticle {
  id          String   @id @default(cuid())
  userId      String
  description String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("news_typed_articles")
}

/// Custom topics for the Music OGP section (mirrors UserNewsTopic).
model UserMusicTopic {
  id           String   @id @default(cuid())
  userId       String
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_music_topics")
}

/// OGP-style music cards (mirrors OgpArticle).
model MusicOgpArticle {
  id                    String    @id @default(cuid())
  userId                String
  title                 String?   @db.Text
  /// Artist name entered in Add Music (free text).
  artist                String?
  image                 String?   @db.Text
  description           String?   @db.Text
  url                   String    @db.Text
  siteName              String?
  type                  String?
  customDescription     String?   @db.Text
  topic                 String
  /// Musical genre selected when adding music (shown as grey chip in topic bar).
  genre                 String?
  /// Song / Album / Playlist selected in Add Music.
  registrationType      String?
  /// True when the creator checked "Put in my favourites" at save time.
  isFavourite           Boolean   @default(false)
  /// Times this music was opened/played (global). Used for Suggested ranking.
  viewCount             Int       @default(0)
  languageCode          String?
  savedAt               DateTime  @default(now())
  expiresAt             DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?
  visibilityUserTypes   String?   @db.Text
  visibilityCountries   String?   @db.Text
  visibilityLanguages   String?   @db.Text
  visibilitySports      String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy             User?     @relation("MusicOgpDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  likes                 MusicOgpArticleLike[]
  listenHistory         MusicOgpListenHistory[]
  groupItems            MusicOgpGroupItem[]

  @@index([userId])
  @@index([userId, topic])
  @@index([deletedAt])
  @@index([viewCount])
  @@map("music_ogp_articles")
}

/// Named collection of OGP Music articles (mirrors OgpNewsGroup).
model MusicOgpGroup {
  id                    String    @id @default(cuid())
  userId                String
  name                  String
  topic                 String
  customDescription     String?   @db.Text
  /// Optional custom cover; when null, UI uses the 1st member OGP's image/video.
  coverImage            String?   @db.Text
  savedAt               DateTime  @default(now())
  expiresAt             DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?
  visibilityUserTypes   String?   @db.Text
  visibilityCountries   String?   @db.Text
  visibilityLanguages   String?   @db.Text
  visibilitySports      String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 MusicOgpGroupItem[]
  likes                 MusicOgpGroupLike[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, topic])
  @@index([topic])
  @@index([deletedAt])
  @@map("music_ogp_groups")
}

model MusicOgpGroupItem {
  id                String          @id @default(cuid())
  groupId           String
  musicOgpArticleId String
  sortOrder         Int             @default(0)
  addedAt           DateTime        @default(now())
  group             MusicOgpGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  musicOgpArticle   MusicOgpArticle @relation(fields: [musicOgpArticleId], references: [id], onDelete: Cascade)

  @@unique([groupId, musicOgpArticleId])
  @@index([groupId])
  @@index([musicOgpArticleId])
  @@map("music_ogp_group_items")
}

model MusicOgpGroupLike {
  id        String        @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime      @default(now())
  group     MusicOgpGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("music_ogp_group_likes")
}

model MusicOgpArticleLike {
  id                 String          @id @default(cuid())
  musicOgpArticleId  String
  userId             String
  createdAt          DateTime        @default(now())
  musicOgpArticle    MusicOgpArticle @relation(fields: [musicOgpArticleId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([musicOgpArticleId, userId])
  @@index([musicOgpArticleId])
  @@index([userId])
  @@map("music_ogp_article_likes")
}

/// Per-user last listen time for "Listen Again" on My Music Home.
model MusicOgpListenHistory {
  id                 String          @id @default(cuid())
  userId             String
  musicOgpArticleId  String
  lastPlayedAt       DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicOgpArticle    MusicOgpArticle @relation(fields: [musicOgpArticleId], references: [id], onDelete: Cascade)

  @@unique([userId, musicOgpArticleId])
  @@index([userId, lastPlayedAt])
  @@index([musicOgpArticleId])
  @@map("music_ogp_listen_history")
}

model MusicTypedArticle {
  id          String   @id @default(cuid())
  userId      String
  description String   @db.Text
  /// Artist name entered in Add Music (free text).
  artist      String?
  /// Track title entered in Add Music (free text).
  title       String?
  /// Song / Album / Playlist selected in Add Music.
  registrationType String?
  /// True when the creator checked "Put in my favourites" at save time.
  isFavourite Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("music_typed_articles")
}

/// Custom topics for My Library of Exercises OGP (scoped by library category).
model UserExerciseTopic {
  id           String   @id @default(cuid())
  userId       String
  /// One of the 9 library categories (e.g. "Isotonic\\weights", "Stretching").
  category     String
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, name])
  @@index([userId])
  @@index([userId, category])
  @@map("user_exercise_topics")
}

/// OGP-style exercise cards for My Library of Exercises (mirrors OgpArticle + category).
model ExerciseOgpArticle {
  id                    String    @id @default(cuid())
  userId                String
  /// One of the 9 library categories.
  category              String
  title                 String?   @db.Text
  image                 String?   @db.Text
  description           String?   @db.Text
  url                   String    @db.Text
  siteName              String?
  type                  String?
  customDescription     String?   @db.Text
  topic                 String
  languageCode          String?
  savedAt               DateTime  @default(now())
  expiresAt             DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?
  visibilityUserTypes   String?   @db.Text
  visibilityCountries   String?   @db.Text
  visibilityLanguages   String?   @db.Text
  visibilitySports      String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy             User?     @relation("ExerciseOgpDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  likes                 ExerciseOgpArticleLike[]
  groupItems            ExerciseOgpGroupItem[]

  @@index([userId])
  @@index([userId, category])
  @@index([userId, category, topic])
  @@index([category])
  @@index([deletedAt])
  @@map("exercise_ogp_articles")
}

model ExerciseOgpArticleLike {
  id                   String             @id @default(cuid())
  exerciseOgpArticleId String
  userId               String
  createdAt            DateTime           @default(now())
  exerciseOgpArticle   ExerciseOgpArticle @relation(fields: [exerciseOgpArticleId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exerciseOgpArticleId, userId])
  @@index([exerciseOgpArticleId])
  @@index([userId])
  @@map("exercise_ogp_article_likes")
}

/// Named collection of OGP Exercise articles.
model ExerciseOgpGroup {
  id                    String    @id @default(cuid())
  userId                String
  name                  String
  category              String
  topic                 String
  customDescription     String?   @db.Text
  coverImage            String?   @db.Text
  savedAt               DateTime  @default(now())
  expiresAt             DateTime?
  deletedAt             DateTime?
  deletedByUserId       String?
  visibilityUserTypes   String?   @db.Text
  visibilityCountries   String?   @db.Text
  visibilityLanguages   String?   @db.Text
  visibilitySports      String?   @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 ExerciseOgpGroupItem[]
  likes                 ExerciseOgpGroupLike[]

  @@unique([userId, category, name])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, category, topic])
  @@index([category])
  @@index([deletedAt])
  @@map("exercise_ogp_groups")
}

model ExerciseOgpGroupItem {
  id                   String             @id @default(cuid())
  groupId              String
  exerciseOgpArticleId String
  sortOrder            Int                @default(0)
  addedAt              DateTime           @default(now())
  group                ExerciseOgpGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exerciseOgpArticle   ExerciseOgpArticle @relation(fields: [exerciseOgpArticleId], references: [id], onDelete: Cascade)

  @@unique([groupId, exerciseOgpArticleId])
  @@index([groupId])
  @@index([exerciseOgpArticleId])
  @@map("exercise_ogp_group_items")
}

model ExerciseOgpGroupLike {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime         @default(now())
  group     ExerciseOgpGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("exercise_ogp_group_likes")
}

model ExerciseTypedArticle {
  id          String   @id @default(cuid())
  userId      String
  category    String
  description String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@map("exercise_typed_articles")
}

model ChatConversation {
  id               String        @id @default(cuid())
  user1Id          String
  user2Id          String
  user1LastReadAt  DateTime?     // Last time user1 read this conversation
  user2LastReadAt  DateTime?     // Last time user2 read this conversation
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user1            User          @relation("ConversationStarter", fields: [user1Id], references: [id], onDelete: Cascade)
  user2            User          @relation("ConversationReceiver", fields: [user2Id], references: [id], onDelete: Cascade)
  messages         ChatMessage[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("chat_conversations")
