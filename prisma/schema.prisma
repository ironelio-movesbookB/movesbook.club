/// Online shop for one club or one team. Separate from the cash-desk product sale ledger.
model ShopSettings {
  id                 String   @id @default(cuid())
  workspaceKind      String
  workspaceId        String
  slug               String   @unique
  displayName        String?
  shopDescription    String?  @db.Text
  shopActive         Boolean  @default(true)
  orderEmailsEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([workspaceKind, workspaceId])
  @@index([slug])
  @@map("shop_settings")
}

model ShopProduct {
  id                 String          @id @default(cuid())
  workspaceKind      String
  workspaceId        String
  name               String
  description        String          @db.Text
  price              Decimal         @db.Decimal(12, 2)
  vatRate            Decimal         @default(0) @db.Decimal(5, 2)
  quantity           Int             @default(0)
  imageUrl           String?         @db.Text
  isVisible          Boolean         @default(true)
  hideFromShop       Boolean         @default(false)
  allowMultipleUnits Boolean         @default(true)
  allowNonMembers    Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orderItems         ShopOrderItem[]

  @@index([workspaceKind, workspaceId])
  @@map("shop_products")
}

model ShopCustomer {
  id            String      @id @default(cuid())
  workspaceKind String
  workspaceId   String
  memberUserId  String?
  firstName     String
  surname       String      @default("")
  email         String      @default("")
  phone         String      @default("")
  taxCode       String      @default("")
  photoUrl      String?     @db.Text
  address       String      @default("")
  city          String      @default("")
  province      String      @default("")
  postalCode    String      @default("")
  dateOfBirth   String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        ShopOrder[]

  @@index([workspaceKind, workspaceId])
  @@index([memberUserId])
  @@map("shop_customers")
}

model ShopOrder {
  id                String          @id @default(cuid())
  orderNumber       String
  workspaceKind     String
  workspaceId       String
  customerId        String?
  memberUserId      String?
  customerName      String
  customerEmail     String          @default("")
  status            ShopOrderStatus @default(PENDING)
  paid              Boolean         @default(false)
  paymentMethod     String          @default("pickup")
  source            String          @default("staff")
  subtotal          Decimal         @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  procedureRecordId String?
  receiptNumber     String?
  invoiceNumber     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customer          ShopCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items             ShopOrderItem[]

  @@unique([workspaceKind, workspaceId, orderNumber])
  @@index([workspaceKind, workspaceId, createdAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  productId String?
  name      String
  unitPrice Decimal      @db.Decimal(12, 2)
  quantity  Int
  order     ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("shop_order_items")
}

