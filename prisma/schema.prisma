model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  senderId        String
  content         String           @db.Text
  telegramMessageId String?        // id from Telegram when sent/received via bot
  createdAt       DateTime        @default(now())
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("chat_messages")
}

/// Admin → users broadcast messages for the Movesbook channel in user chat.
model ChatBroadcastMessage {
  id           String   @id @default(cuid())
  content      String   @db.LongText
  mode         String   // all | group | subscribers | favourites | repliers | reply
  senderName   String   @default("Movesbook admin")
  /// Null = platform Movesbook Channel. Set = Club Channel for that club.
  clubId       String?
  /// JSON string[] of target user IDs. Null = all Telegram-linked users (mode=all).
  /// For mode=reply: JSON { parentId, senderUserId }.
  /// For mode=repliers: JSON string[] of users who replied to broadcasts (Chat users → All).
  recipientIds String?  @db.LongText
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([mode])
  @@index([clubId])
  @@map("chat_broadcast_messages")
}

/// User-owned threads: REVIEW (private) and SUPPORT (community feed)
model UserMessageThread {
  id              String                @id @default(cuid())
  userId          String
  kind            UserMessageThreadKind
  subject         String                @default("")
  languageCode    String?               @db.VarChar(32)
  pathStaff       String?               @db.VarChar(2048)
  realPath        String?               @db.VarChar(2048)
  errorMessage    String?               @db.VarChar(1000)
  supportCategory String?               @db.VarChar(32)
  /// Workflow status for Suggestions, Problems, and bug/fix memos.
  /// Legacy assistance also used: S=Started, C=Completed, D=Decline
  status          String?               @db.VarChar(32)
  /// Marked inappropriate by staff/admin (formerly "spam")
  isInappropriate Boolean               @default(false)
  /// JSON array of up to 3 public image URLs attached to the first post
  imageUrls       String?               @db.Text
  likeCount       Int                   @default(0)
  dislikeCount    Int                   @default(0)
  isPublic        Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        UserThreadMessage[]
  likes           UserMessageThreadLike[]

  @@index([userId])
  @@index([userId, kind])
  @@index([supportCategory])
  @@index([languageCode])
  @@index([isPublic, kind])
  @@index([status])
  @@map("user_message_threads")
}

model UserThreadMessage {
  id        String            @id @default(cuid())
  threadId  String
  senderId  String?
  isStaff   Boolean           @default(false)
  body      String            @db.Text
  createdAt DateTime          @default(now())
  thread    UserMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User?             @relation("UserThreadMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@map("user_thread_messages")
}

/// Per-user like/dislike on a support/review thread (legacy Assistance_like)
model UserMessageThreadLike {
  id        String            @id @default(cuid())
  threadId  String
  userId    String
  /// L = like, D = dislike
  reaction  String            @db.VarChar(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  thread    UserMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("user_message_thread_likes")
}

enum UserMessageThreadKind {
  REVIEW
  SUPPORT
}

