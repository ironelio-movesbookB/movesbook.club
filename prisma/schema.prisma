/// Operator and Co-Admin accounts managed from the admin console (separate from `User` / `users_new`).
model StaffAccount {
  id                   String           @id @default(cuid())
  kind                 StaffAccountKind
  username             String           @unique
  email                String           @unique
  password                         String
  /// Hashed temporary password others can use to access this account.
  alternatePassword                String?
  /// When true, alternate password is cleared after the delegate logs out.
  alternatePasswordOneAccessOnly   Boolean          @default(false)
  name                 String
  surname              String
  country              String?
  operatorLanguage     String?
  idCardCode           String?
  commissionPct        String?
  commissionAutoAssign Boolean          @default(false)
  regions              String?
  roleLabel            String?
  alternateEmail       String?
  phonePrefix          String?
  phoneNumber          String?
  cellularPrefix       String?
  cellularNumber       String?
  facebook             String?
  twitter              String?
  website              String?
  blogsite             String?
  otherSite            String?
  otherInfos           String?          @db.LongText
  imageUrl             String?          @db.LongText
  lastLogin            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  assignedUsers        StaffAssignedUser[]
  loginLogs            StaffAccountLoginLog[]
  coAdminLink          StaffOperatorCoAdminLink?  @relation("OperatorCoAdminLinkOperator")
  operatorsAsCoAdmin   StaffOperatorCoAdminLink[] @relation("OperatorCoAdminLinkCoAdmin")

  @@map("staff_accounts")
}

/// Links one co-admin to one operator (operator has at most one co-admin; co-admin may have many operators).
model StaffOperatorCoAdminLink {
  id         String   @id @default(cuid())
  operatorId String   @unique
  coAdminId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  operator   StaffAccount @relation("OperatorCoAdminLinkOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  coAdmin    StaffAccount @relation("OperatorCoAdminLinkCoAdmin", fields: [coAdminId], references: [id], onDelete: Cascade)

  @@index([coAdminId])
  @@map("staff_operator_coadmin_links")
}

/// Login / logout audit rows for an operator or co-admin (admin "Logins" tab).
model StaffAccountLoginLog {
  id             String       @id @default(cuid())
  staffAccountId String
  loginAt        DateTime
  logoutAt       DateTime?
  createdAt      DateTime     @default(now())
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)

  @@index([staffAccountId, loginAt])
  @@index([staffAccountId, logoutAt])
  @@map("staff_account_login_logs")
}

/// Users assigned to an operator or co-admin from the admin "My Customers" screen.
model StaffAssignedUser {
  id              String       @id @default(cuid())
  staffAccountId  String
  /// When set, row mirrors a Movesbook `users_new` account selected in the assign picker.
  movesbookUserId String?
  username        String
  name            String
  country         String?
  language        String?
  lastLogin       DateTime?
  imageUrl        String?      @db.LongText
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  staffAccount    StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)

  @@unique([staffAccountId, movesbookUserId])
  @@index([staffAccountId])
  @@index([movesbookUserId])
  @@map("staff_assigned_users")
}

enum StaffAccountKind {
  OPERATOR
  CO_ADMIN
}

