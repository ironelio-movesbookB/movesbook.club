// ---------------------------------------------------------------------------
// Club procedure engine (greenfield)
// ---------------------------------------------------------------------------

enum ProcedureRecordStatus {
  ACTIVE
  DELETED
}

enum ClubOutcomeMode {
  EN
  COUNTRY_STANDARD
  CUSTOM
}

model ProcedureType {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  description String?           @db.Text
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  records     ProcedureRecord[]

  @@map("procedure_types")
}

model ProcedureRecord {
  id              String                @id @default(cuid())
  procedureTypeId String
  /// clubs_new.id, or teams_new.id in a Team workspace — so no foreign key to clubs_new.
  clubId          String
  memberId        String
  operatorId      String?
  totalAmount     Decimal               @db.Decimal(12, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(12, 2)
  balanceAmount   Decimal               @db.Decimal(12, 2)
  recordDate      DateTime              @db.Date
  dueDate         DateTime?             @db.Date
  notes           String?               @db.Text
  metadata        Json?
  status          ProcedureRecordStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  procedureType ProcedureType    @relation(fields: [procedureTypeId], references: [id], onDelete: Restrict)
  member        User             @relation("ProcedureMember", fields: [memberId], references: [id], onDelete: Restrict)
  operator      User?            @relation("ProcedureOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  payments      ProcedurePayment[]
  receipts      ProcedureReceipt[]
  installments  ProcedureInstallment[]

  @@index([clubId, procedureTypeId, status])
  @@index([clubId, balanceAmount])
  @@index([memberId])
  @@index([recordDate])
  @@map("procedure_records")
}

model ProcedurePayment {
  id                String   @id @default(cuid())
  procedureRecordId String
  amount            Decimal  @db.Decimal(12, 2)
  balanceAfter      Decimal? @db.Decimal(12, 2)
  paymentDate       DateTime @db.Date
  operatorId        String?
  payMode           String?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// Also added on first use by src/lib/procedures/paymentVerification.ts.
  toBeVerified      Boolean  @default(false)

  procedureRecord ProcedureRecord  @relation(fields: [procedureRecordId], references: [id], onDelete: Cascade)
  operator        User?            @relation("ProcedurePaymentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  receipts        ProcedureReceipt[]

  @@index([procedureRecordId, paymentDate])
  @@map("procedure_payments")
}

model ProcedureReceipt {
  id                 String   @id @default(cuid())
  procedureRecordId  String
  procedurePaymentId String?
  /// clubs_new.id, or teams_new.id in a Team workspace — so no foreign key to clubs_new.
  clubId             String
  memberId           String
  operatorId         String?
  documentType       String?
  documentNumber     String?
  amount             Decimal  @db.Decimal(12, 2)
  paymentAmount      Decimal  @default(0) @db.Decimal(12, 2)
  annotations        String?  @db.Text
  serviceName        String?
  receiptDate        DateTime @db.Date
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  procedureRecord  ProcedureRecord   @relation(fields: [procedureRecordId], references: [id], onDelete: Cascade)
  procedurePayment ProcedurePayment? @relation(fields: [procedurePaymentId], references: [id], onDelete: SetNull)
  member           User              @relation("ProcedureReceiptMember", fields: [memberId], references: [id], onDelete: Restrict)
  operator         User?             @relation("ProcedureReceiptOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([clubId, procedureRecordId])
  @@map("procedure_receipts")
}

model ProcedureInstallment {
  id                String    @id @default(cuid())
  procedureRecordId String
  paid              Decimal   @default(0) @db.Decimal(12, 2)
  balance           Decimal   @db.Decimal(12, 2)
  paymentDate       DateTime  @db.Date
  expireDate        DateTime? @db.Date
  description       String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  procedureRecord ProcedureRecord @relation(fields: [procedureRecordId], references: [id], onDelete: Cascade)

  @@index([procedureRecordId, paymentDate])
  @@map("procedure_installments")
}

