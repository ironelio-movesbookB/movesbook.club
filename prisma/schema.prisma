/// Broadcast notifications from Movesbook Staff / Club / Coach / Team / Group (not 1:1 messages).
model Notification {
  id                   String              @id @default(cuid())
  /// movesbook_staff | club_admin | coach | team_admin | group_admin
  source               String
  title                String
  description          String              @db.LongText
  path                 String?             @db.Text
  untilDate            DateTime            @db.Date
  /// Legacy single lang id; prefer audienceLanguagesJson. Empty / "0" / null = all
  langId               String?
  prioritary           Boolean             @default(false)
  isShow               Boolean             @default(true)
  /// Club admin / coach / team / group / user who submitted (users_new.id)
  submittedByUserId    String?
  /// Super Admin / staff account id when source is movesbook_staff
  submittedByAdminId   String?
  /// JSON string[] of UserType values for staff broadcasts (app sets "[]" on insert; no DB default — MySQL <8.0.13 rejects TEXT defaults)
  audienceRolesJson     String              @db.Text
  /// JSON string[] of usernames (staff targeting per requirement)
  audienceUsernamesJson String              @db.Text
  /// JSON string[] of resolved user ids from usernames
  audienceUserIdsJson   String              @db.Text
  /// JSON string[] of entity ids (clubs / teams / groups / coaching groups depending on source)
  clubIdsJson           String              @db.Text
  /// members | staff — club audience kind
  audienceKind         String              @default("members")
  /// ISO language codes for Super Admin targeting (e.g. ["en","it"]); empty / null = all languages
  audienceLanguagesJson String?            @db.Text
  /// Per-language HTML bodies {"en":"...","it":"..."}; English used as fallback
  contentsByLangJson   String?             @db.LongText
  /// Per-language titles {"en":"...","it":"..."}; English / `title` used as fallback
  titlesByLangJson     String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  submittedByUser      User?               @relation("NotificationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  visits               NotificationVisit[]

  @@index([source, isShow, untilDate])
  @@index([submittedByUserId])
  @@index([createdAt])
  @@map("app_notifications")
}

model NotificationVisit {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("app_notification_visits")
}

