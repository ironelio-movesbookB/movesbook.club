// Legacy promocode tables (PHP movesbook-new compatibility).
// Live deploy: npm run db:ensure-promocode-meta  — do NOT use prisma db push
// to apply promocode columns (db push would try to reshape the whole live DB).
// ---------------------------------------------------------------------------

model PromocodeSetting {
  id                  Int       @id @default(autoincrement())
  code                String    @db.VarChar(100)
  validFrom           DateTime  @map("valid_from") @db.Date
  validTo             DateTime  @map("valid_to") @db.Date
  usableBy            String    @default("Once") @map("usable_by") @db.VarChar(16)
  used                Int       @default(0)
  versionId           String    @default("") @map("version_id") @db.VarChar(100)
  discount            Int       @default(0)
  enable              String    @default("Disable") @db.VarChar(16)
  enableExtension     Int?      @default(0) @map("enable_extension")
  subscriptionExtends Int?      @map("subscription_extends")
  socialOptions       String?   @map("social_options") @db.VarChar(500)
  managementSection   String?   @map("management_section") @db.VarChar(50)
  enableFreeAccounts  Int?      @default(0) @map("enable_free_accounts")
  basicVersion        String?   @map("basic_version") @db.VarChar(100)
  premiumVersion      String?   @map("premium_version") @db.VarChar(100)
  professionalVersion String?   @map("professional_version") @db.VarChar(100)
  deleteStatus        Int       @default(2) @map("delete_status")
  deleteDate          DateTime? @map("delete_date") @db.Date
