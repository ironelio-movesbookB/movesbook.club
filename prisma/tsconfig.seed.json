{
    "compilerOptions": {
      "target": "ES2019",
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "noEmit": true,
      "baseUrl": "..",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": [
      "seed.ts",
      "seed-outcomes.ts",
      "seed-procedure-types.ts",
      "seed-payment-info.ts",
      "../scripts/migrate-outcomes-from-legacy.ts",
      "../src/lib/news/contentParser.ts",
      "../src/constants/**/*.ts",
      "../src/lib/promocodes/**/*.ts",
      "../src/lib/outcomeSettingsDb.ts",
      "../src/lib/outcomeSettingsSeed.ts",
      "../src/lib/outcomes/**/*.ts",
      "../src/lib/club/legacyTableLookup.ts",
      "../src/lib/prisma.ts",
      "../src/lib/users/quickRegisterSubscriptionSeed.ts"
    ]
  }